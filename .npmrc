# Host-provided packages (@earendil-works/pi-*, declared as peerDependencies)
# must NOT be installed locally — the Pi host supplies them at runtime via the
# extension loader (jiti aliases + virtual modules; see Pi docs/packages.md
# "Declare dependencies"). Pi's own installer runs with --omit=peer /
# --legacy-peer-deps, and installing host packages creates duplicate runtime
# modules that bypass the extension loader.
#
# This flag only affects plain `npm install` in a dev checkout: npm 7+
# auto-installs peerDependencies, which would silently re-create the duplicates
# the peerDependencies declaration was meant to avoid. Dev-time type resolution
# comes from devDependencies (stripped by Pi with --omit=dev at install).
legacy-peer-deps=true
package-lock=true
